{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "An AWS Serverless Application. This template is partially managed by Amazon.Lambda.Annotations (v1.9.0.0).",
  "Resources": {
    "MaxPainFunction": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Handler": "MaxPainLambda::MaxPainLambda.Functions::GetHandlerAsync",
        "Runtime": "dotnet8",
        "CodeUri": "",
        "Description": "MaxPain Lambda function with optimized ARM64 configuration",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 2048,
        "Timeout": 30,
        "ReservedConcurrentExecutions": 10,
        "Environment": {
          "Variables": {
            "AWS_CONNECTION_STRING": "PLACEHOLDER_UPDATE_IN_AWS_CONSOLE",
            "HOME_CONNECTION_STRING": "PLACEHOLDER_UPDATE_IN_AWS_CONSOLE"
          }
        },
        "Policies": [
          "AWSLambdaBasicExecutionRole",
          "AWSLambdaVPCAccessExecutionRole"
        ],
        "Events": {
          "ApiEvent": {
            "Type": "HttpApi",
            "Properties": {
              "Path": "/{proxy+}",
              "Method": "ANY"
            }
          }
        }
      }
    }
  },
  "Outputs": {
    "ApiURL": {
      "Description": "API endpoint URL for Prod environment",
      "Value": {
        "Fn::Sub": "https://${ServerlessHttpApi}.execute-api.${AWS::Region}.amazonaws.com/"
      }
    },
    "FunctionArn": {
      "Description": "MaxPain Lambda Function ARN",
      "Value": {
        "Fn::GetAtt": [
          "MaxPainFunction",
          "Arn"
        ]
      }
    }
  }
}